# ─────────────────────────────────────────────────────────────────────────────
# Candylandia Store — configuración
#
#   cp .env.example .env
#   chmod 600 .env
#
# Este archivo (el .example) sí va a git. El .env de verdad NO: lleva la clave
# de la base de datos y la del JWT. Está en .gitignore; no lo saques de ahí.
# ─────────────────────────────────────────────────────────────────────────────

# ── Identidad del sitio ─────────────────────────────────────────────────────
SITE_NAME=Candylandia Store
SITE_URL=https://candylandiastore.mx

# En producción SIEMPRE False. En True, FastAPI publica /docs sin clave y
# SQLAlchemy escribe cada consulta en los logs.
DEBUG=False

# ── Base de datos ───────────────────────────────────────────────────────────
# Postgres corre en el HOST, no en un contenedor: `host.docker.internal` es
# como lo ve el contenedor (funciona gracias al extra_hosts del compose).
# Desde tu máquina, sin Docker, cambia ese trozo por `localhost`.
#
# La contraseña la genera deploy.sh la primera vez que crea la base.
DATABASE_URL=postgresql+psycopg://candylandia:CAMBIA_ESTA_CLAVE@host.docker.internal:5432/candylandia

# La misma contraseña, suelta. La aplicación no la lee; la usa deploy.sh para
# crear el rol en el Postgres del host y para comprobar que la DATABASE_URL de
# arriba no se quedó con una contraseña vieja.
POSTGRES_PASSWORD=CAMBIA_ESTA_CLAVE

# ── Sesiones del panel ──────────────────────────────────────────────────────
# Firma los tokens del panel. Cambiarla cierra la sesión de todo el mundo.
# Para generar una nueva:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiame-en-el-env

JWT_ALGORITMO=HS256
# 720 minutos = 12 horas. Una jornada de trabajo sin tener que volver a entrar.
JWT_MINUTOS=720

# ── Administrador inicial ───────────────────────────────────────────────────
# Solo se usa la PRIMERA vez, cuando la tabla de usuarios está vacía. Si ya
# hay un usuario, esto se ignora: cambiar la contraseña aquí no la cambia en
# la base. Para eso está `./deploy.sh --admin`.
#
# Dejar ADMIN_PASSWORD vacío es válido: deploy.sh genera una al crear el sitio
# y te la enseña una vez.
ADMIN_USUARIO=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=

# ── CORS ────────────────────────────────────────────────────────────────────
# En producción el front y el API salen por el mismo dominio, así que esto
# solo hace falta para el `npm run dev` de tu máquina.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Fotos de los productos ──────────────────────────────────────────────────
# MEDIA_ROOT es la ruta DENTRO del contenedor; en el host es ./datos/media,
# que es lo que monta docker-compose.yml.
MEDIA_ROOT=/app/media
MEDIA_URL=/media

# El lado mayor al que se reduce cada foto. 560 px es el ancho de la tarjeta
# en una pantalla grande con densidad doble: más grande solo pesa.
IMAGEN_LADO_MAX=560
IMAGEN_CALIDAD=82
# Tope del archivo ORIGINAL que se acepta subir, en bytes (8 MB). El nginx
# del contenedor del front deja pasar hasta 12 MB para que el error que se ve
# sea el del backend, escrito en castellano, y no un 413 pelado.
IMAGEN_PESO_MAX=8388608

# ── Tienda ──────────────────────────────────────────────────────────────────
# Número de WhatsApp al que van los botones de «Lo quiero», con código de país
# y sin signos: 52 (México) + 1 + los diez dígitos.
WHATSAPP=5215512345678

# ── Despliegue ──────────────────────────────────────────────────────────────
# Dominio del sitio. El registro A tiene que apuntar ya a la IP de la VPS: si
# no, Certbot no puede emitir el certificado.
DOMAIN=candylandiastore.mx
# Dominios extra para el mismo certificado, separados por coma (www, etc.).
# Cada uno necesita SU registro DNS; si falta, la emisión falla entera.
DOMAIN_ALIASES=www.candylandiastore.mx

# Dirección a la que Let's Encrypt avisa si un certificado va a caducar.
LETSENCRYPT_EMAIL=

# Puerto del loopback donde escucha el front. El nginx del host reenvía aquí.
# Mapa del VPS: 8515 consultorio · 8516 inmobiliaria · 8517 marketing
#               8518 panel_bot · 8519 seguros · 8520 candylandia
APP_PORT=8520

# Procesos de gunicorn. La regla cómoda es (2 × núcleos) + 1; con 1 núcleo,
# 3 va sobrado para una dulcería.
GUNICORN_WORKERS=3
